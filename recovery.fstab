# Dynamic partitions (fail-safe for multiple filesystems)
system    /system    erofs    ro    wait,logical,first_stage_mount
system    /system    f2fs     ro    wait,logical,first_stage_mount
system    /system    ext4     ro    wait,logical,first_stage_mount
vendor    /vendor    erofs    ro    wait,logical,first_stage_mount
system_ext    /system_ext    erofs    ro    wait,logical,first_stage_mount
vendor_dlkm    /vendor_dlkm    erofs    ro    wait,logical,first_stage_mount
product    /product    erofs    ro    wait,logical,first_stage_mount
odm    /odm    erofs    ro    wait,logical,first_stage_mount
system_dlkm    /system_dlkm    erofs    ro    wait,logical,first_stage_mount
system_dlkm    /system_dlkm    f2fs     ro    wait,logical,first_stage_mount
system_dlkm    /system_dlkm    ext4     ro    wait,logical,first_stage_mount

# Physical partitions
/boot    emmc    /dev/block/bootdevice/by-name/boot    flags=backup=1;display=boot
/recovery    emmc    /dev/block/bootdevice/by-name/recovery    flags=backup=1;display=recovery
/metadata    ext4    /dev/block/by-name/metadata    wait,check,formattable,first_stage_mount
/data    f2fs    /dev/block/bootdevice/by-name/userdata    noatime,nosuid,nodev,discard,inlinecrypt    wait,check,fileencryption=ice,quota,formattable,reservedsize=128M
/cache    ext4    /dev/block/bootdevice/by-name/cache    wait,check,formattable
/efs    ext4    /dev/block/bootdevice/by-name/sec_efs    wait,check,formattable
/sec_efs    ext4    /dev/block/bootdevice/by-name/sec_efs    wait,check,formattable
/carrier    ext4    /dev/block/bootdevice/by-name/carrier    wait,check,formattable
/modem    emmc    /dev/block/bootdevice/by-name/apnhlos    flags=display=modem
/mdm    emmc    /dev/block/bootdevice/by-name/modem    flags=display=mdm
/dsp    emmc    /dev/block/bootdevice/by-name/dsp    flags=display=dsp
/misc    emmc    /dev/block/bootdevice/by-name/misc    defaults
/keydata    ext4    /dev/block/bootdevice/by-name/keydata    wait,check,formattable
/keyrefuge    f2fs    /dev/block/bootdevice/by-name/keyrefuge    wait,check,formattable
/dtbo    emmc    /dev/block/bootdevice/by-name/dtbo    flags=display=dtbo
/prism    ext4    /dev/block/bootdevice/by-name/prism    wait,check,formattable
/optics    ext4    /dev/block/bootdevice/by-name/optics    wait,check,formattable
/vbmeta_system    emmc    /dev/block/bootdevice/by-name/vbmeta_system    flags=display=vbmeta_system
/vendor_boot    emmc    /dev/block/bootdevice/by-name/vendor_boot    flags=display=vendor_boot
/vbmeta_samsung    emmc    /dev/block/bootdevice/by-name/vbmeta_samsung    flags=display=vbmeta_samsung
/imagefv    emmc    /dev/block/bootdevice/by-name/imagefv    flags=display=imagefv
/sdcard    sdfat    /dev/block/mmcblk0p1    flags=display=sdcard;storage;wipeingui
/init_boot    emmc    /dev/block/bootdevice/by-name/init_boot    flags=display=init_boot
/vm-bootsys    ext4    /dev/block/bootdevice/by-name/vm-bootsys    wait,check,formattable
/qweslicstore    emmc    /dev/block/bootdevice/by-name/qweslicstore    flags=display=qweslicstore